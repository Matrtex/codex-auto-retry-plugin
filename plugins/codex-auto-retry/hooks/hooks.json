{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/auto_retry_stop.py\"",
            "commandWindows": "py -3 ([System.IO.Path]::Combine($env:PLUGIN_ROOT, 'scripts', 'auto_retry_stop.py'))",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
